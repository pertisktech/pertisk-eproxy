%% Erlang LS / editor: resolve `-include_lib("lager/include/lager.hrl")` and other deps.
%% Run `rebar3 compile` first so `_build/default/lib/*/include` exists.

[
  {apps_dirs, [
    "_build/default/lib/*/ebin",
    "_build/default/lib/*/src",
    "_build/default/lib/*/_build/*/lib/*/ebin",
    "_build/default/lib/*/_build/*/lib/*/src"
  ]},
  {deps_dirs, [
    "_build/default/lib",
    "_build/default/lib/*/src",
    "_build/default/lib/*/include"
  ]},
  {include_dirs, [
    "include",
    "_build/default/lib/*/include"
  ]}
].
