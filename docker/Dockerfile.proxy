# syntax=docker/dockerfile:1.7
# Proxy + admin image (proxy mode via config/proxy.json).
# Harbor: harbor.tools.thaidevops.co/pertisksoft/pertisk-eproxy/proxy

ARG VERSION=0.1.0
ARG FRONTEND_BUILD_ID=dev

FROM node:20-alpine AS admin-builder

ARG VERSION
ARG FRONTEND_BUILD_ID
ENV VITE_BUILD_ID=${FRONTEND_BUILD_ID}

WORKDIR /app/admin

COPY admin/package.json admin/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts 2>/dev/null || npm install

COPY admin/ ./
RUN npm run build

# buildx sets the platform per matrix leg; do not use empty BUILDPLATFORM on FROM
FROM erlang:29-alpine AS builder

ARG VERSION
# +JMsingle: required when linux/amd64 is built under QEMU (e.g. Apple Silicon);
# without it prim_tty NIF fails and kernel exits with nouser during rebar3.
ENV ERL_FLAGS="+JMsingle true -noshell -noinput"
ENV ERL_AFLAGS="-noshell -noinput"

WORKDIR /src

RUN apk add --no-cache bash git build-base cmake ninja perl patch linux-headers openssl openssl-dev ncurses-dev ncurses-libs

COPY . .
COPY --from=admin-builder /app/priv/admin ./priv/admin

# ekub 0.2.0 sets fail_if_no_peer_cert (server-only) on K8s API client SSL — patch before compile.
RUN chmod +x \
    /src/scripts/set-app-version.sh \
    /src/scripts/patch-ekub.sh \
    /src/scripts/patch-quic.sh \
    /src/scripts/patch-hackney.sh \
    && /src/scripts/set-app-version.sh "$VERSION" \
    && rm -rf _build deps \
    && rebar3 get-deps \
    && /src/scripts/patch-ekub.sh \
    && /src/scripts/patch-quic.sh \
    && /src/scripts/patch-hackney.sh \
    && /src/scripts/verify-deps.sh /src \
    && mkdir -p priv/tls \
    && openssl req -x509 -newkey rsa:2048 -keyout priv/tls/listener.key -out priv/tls/listener.pem \
         -days 3650 -nodes -subj "/CN=localhost" \
    && rebar3 as prod release \
    && /src/scripts/verify-release-build.sh /src \
    && /src/scripts/verify-release-quic.sh /src

# Runtime must provide OpenSSL >= 3.4 symbols (e.g. EVP_MD_CTX_get_size_ex) for OTP 29 crypto NIF.
# Alpine 3.20 apk openssl is too old; copy libs from erlang:29-alpine builder.
FROM alpine:3.20

ARG APP_HOME=/opt/pertisk_eproxy

RUN apk add --no-cache ca-certificates libstdc++ ncurses-libs bash wget sqlite openssl patch \
    && addgroup -g 1000 -S pertisk \
    && adduser -u 1000 -S -G pertisk -h /opt/pertisk_eproxy -s /sbin/nologin pertisk

WORKDIR ${APP_HOME}

COPY --from=builder /usr/lib/libcrypto.so* /usr/lib/
COPY --from=builder /usr/lib/libssl.so* /usr/lib/
COPY --from=builder /lib/libcrypto.so* /lib/
COPY --from=builder /lib/libssl.so* /lib/

COPY --chown=pertisk:pertisk --from=builder /src/config ./config
COPY --chown=pertisk:pertisk --from=builder /src/_build/prod/rel/pertisk_eproxy/ ./

RUN rm -f "${APP_HOME}/log/crash.log" "${APP_HOME}/log/error.log" "${APP_HOME}/log/proxy.log" 2>/dev/null || true \
    && mkdir -p "${APP_HOME}/log" "${APP_HOME}/data" \
    && chown -R pertisk:pertisk "${APP_HOME}" \
    && chmod 775 "${APP_HOME}/log" "${APP_HOME}/data"

ENV PERTISK_CONFIG_FILE=/opt/pertisk_eproxy/config/proxy.json

USER pertisk

EXPOSE 8080 8443 9080 9090 8443/udp

# Uses management listener (default 127.0.0.1:9080). Override in Compose/K8s if `management_port` differs.
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:9080/api/health || exit 1

ENTRYPOINT ["bin/pertisk_eproxy"]
CMD ["foreground"]
