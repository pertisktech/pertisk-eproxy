# Node name (for distributed Erlang / remsh)
-name pertisk_eproxy@127.0.0.1

# Cookie for distributed Erlang (change in production)
-setcookie pertisk_eproxy_cookie

# Heartbeat monitor (restart VM on crash)
# -heart

# Schedulers: do not use "+S auto" (invalid — VM exits with "bad amount of schedulers auto").
# Omit +S to use all CPUs visible to the pod (respects cgroup limits in K8s).
# Optional fixed count for small CPU limits: +S 2:2

# Disable scheduler busy-wait spinning. Under Kubernetes CFS CPU limits the
# default (+sbwt medium) burns quota on spin loops, causing throttling that
# inflates p95 latency and caps throughput (k6 /api/health benchmarks).
+sbwt none
+sbwtdcpu none
+sbwtdio none

# Async thread pool (QUIC UDP I/O at high throughput needs many async threads)
+A 64

# Maximum number of ports (file descriptors)
+Q 65536

# Increase process limit
+P 1048576

# Enable kernel poll
+K true