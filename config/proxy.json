{
  "http_addr": "0.0.0.0",
  "http_port": 8080,
  "management_addr": "127.0.0.1",
  "management_port": 9080,
  "mode": "proxy_admin",

  "certificates": [
    "example-wildcard-cert",
    "localhost-dev-cert"
  ],

  "dns_providers": [
    "cloudflare",
    "route53",
    "manual"
  ],

  "sites": [
    {
      "host": "example.localhost",
      "backend": "example-backend",
      "certificate": "example-wildcard-cert",
      "dns_provider": "cloudflare",
      "routes": [
        {"path": "/api", "path_type": "prefix", "rewrite": "/"},
        {"path": "/",    "path_type": "prefix"}
      ]
    }
  ],

  "backends": [
    {
      "name": "example-backend",
      "algorithm": "round_robin",
      "upstreams": [
        {"addr": "127.0.0.1:3000", "weight": 1},
        {"addr": "127.0.0.1:3001", "weight": 1}
      ],
      "health_path": "/health",
      "health_interval_secs": 30
    }
  ]
}
