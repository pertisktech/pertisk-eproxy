[
  {pertisk_eproxy, [
    % Listen configuration
    {listen_addr, "any"},
    {listen_port_http, 80},
    {listen_port_h2, 443},
    {listen_port_https, 443},
    {listen_port_h3, 443},
    %% HTTP/3 POST/PUT/PATCH: max body size (bytes) and read timeout (ms)
    %% {h3_max_request_body_bytes, 10485760},
    %% {h3_request_body_timeout_ms, 120000},
    %% erlang_quic binds (1 + quic_listener_pool_size) UDP listeners per server name (SO_REUSEPORT when >1).
    {quic_listener_pool_size, 0},
    
    % Admin interface
    {admin_port, 8080},
    {tls_certfile, "tls/arm-thaidevops.co-cert.pem"},
    {tls_keyfile, "tls/arm-thaidevops.co-key.pem"},
    {h3_tls_certfile, "tls/arm-thaidevops.co-cert.pem"},
    {h3_tls_keyfile, "tls/arm-thaidevops.co-key.pem"},
    {upstreams_file, "config/upstreams.json"},
    
    % ACME configuration
    {acme_enabled, true},
    {acme_provider, "https://acme-v02.api.letsencrypt.org/directory"},
    {acme_email, "dotnetnat@gmail.com"},
    
    % Compression
    {compression_methods, [brotli, zstd, gzip]},
    
    % Upstreams loaded on startup
    {upstreams, [
      {<<"admin.arm.thaidevops.co">>, #{
        <<"target">> => <<"http://localhost:8080">>,
        <<"health_check">> => <<>>,
        <<"weight">> => 1
      }}
    ]}
  ]},
  
  {kernel, [
    %% JSON logs to stdout via OTP logger + jsonlog (https://github.com/tsloughter/jsonlog)
    {logger_level, info},
    {logger, [
        {handler, default, logger_std_h, #{
            level => info,
            formatter => {jsonlog, #{
                json_encode => fun jsonlog_jsone_encoder:encode/2
            }}
        }}
    ]}
  ]},

  {ssl, [
    % SSL configuration for QUIC
  ]}
].
