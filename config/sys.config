[
  {pertisk_eproxy, [
    {log_app_name, <<"pertisk-eproxy">>},
    %% Path to the JSON proxy config file (see config/proxy.json for format)
    {config_file, "config/proxy.json"},
    %% `pertisk_eproxy_db` runs the `sqlite3` CLI (required on RPM/Docker hosts).
    {sqlite3_executable, "/usr/bin/sqlite3"},
    {db_file, "data/proxy.db"},
    %% Admin API: disabled (open management port) | local (Bearer token; users in SQLite `admin_users`, default admin/admin on first DB)
    {admin_auth, local},
    %% Legacy env key; local login uses SQLite `admin_users` (see pertisk_eproxy_db:ensure_admin_users/1).
    {admin_password, <<"admin">>},

    %% Auth0 SPA (admin UI SSO). When domain + client_id are set, GET /api/auth/config exposes SSO and
    %% the API accepts Auth0 RS256 access tokens in Authorization: Bearer.
    %% In Auth0 Dashboard: Application type SPA; add this app’s origin to Allowed Callback URLs, Web Origins, Logout URLs (e.g. http://YOUR_HOST:9080 for embedded admin; default bind is 0.0.0.0:9080).
    {admin_auth0_domain, "dev-od6cfzs2tugxm53g.us.auth0.com"},
    {admin_auth0_client_id, "XcGrd3qtHMOWnhUrhPcat2oUdBkFDw2P"},
    %% Auth0 API identifier (access token `aud`). Management API default is below; authorize this SPA for that API in Dashboard if you use it.
    {admin_auth0_audience, <<"https://dev-od6cfzs2tugxm53g.us.auth0.com/api/v2/">>},

    %% ACME / Let's Encrypt (DNS-01 via Cloudflare). Requires openssl in PATH for CSR generation.
    %% Set to true only if the operator agrees to the subscriber terms of `acme_directory_url`
    %% (e.g. https://letsencrypt.org/repository/ when using production Let's Encrypt).
    {acme_terms_agreed, true},
    %% Production Let's Encrypt. For dry-runs use staging:
    %% "https://acme-staging-v02.api.letsencrypt.org/directory"
    %% When switching staging <-> production, remove data/acme/account.pem and data/acme/kid.txt
    %% (account is per-CA); then restart so a new ACME account is registered.
    %% kid.txt pointing at staging is deleted automatically on prod issuance if you only change this URL.
    {acme_directory_url, "https://acme-v02.api.letsencrypt.org/directory"},
    {acme_data_dir, "data/acme"},
    %% After Cloudflare TXT create, wait before answering challenges (wildcard+apex share one _acme-challenge name).
    {acme_dns_propagation_delay_ms, 15000},

    %% Optional CouchDB sink for access logs (best-effort async write).
    {couchdb_log, #{
      enabled => false,
      url => "https://couchdb.cloud.pertisksoft.net/",
      db => "pertisk-eproxy",
      username => "admin",
      password => "56255625",
      create_db => true
    }}

  ]},

  {lager, [
    {handlers, [
      %% Default until pertisk_eproxy_log_level:apply/0 runs (JSON log_level or PERTISK_LOG_LEVEL).
      {lager_console_backend, [
        {level, info},
        {use_stderr, true},
        {formatter, pertisk_eproxy_lager_json_formatter},
        {formatter_config, []}
      ]},
      %% Release start.script sets lager log_root to "log"; paths are relative to that dir.
      {lager_file_backend, [
        {file, "error.log"},
        {level, error},
        {formatter, pertisk_eproxy_lager_json_formatter},
        {formatter_config, []}
      ]},
      {lager_file_backend, [
        {file, "proxy.log"},
        {level, info},
        {formatter, pertisk_eproxy_lager_json_formatter},
        {formatter_config, []}
      ]},
      %% Mirror warning/error/crash messages into the in-memory ring buffer
      %% so they appear in the admin UI (System / Crash-Error tabs).
      {pertisk_eproxy_lager_ring_backend, []}
    ]},
    {error_logger_hwm, 200}
  ]},

  {sasl, [
    {sasl_error_logger, false}
  ]}
].
