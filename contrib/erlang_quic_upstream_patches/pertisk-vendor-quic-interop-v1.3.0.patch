+    %% RFC 9204 §4.5.1.2: Sign==0 => Base=RIC+DeltaBase; Sign==1 => Base=RIC-DeltaBase-1.
+    %% Sign==1 requires RIC > DeltaBase. For RIC=0, Base=0 use Sign=0, DeltaBase=0.
     RICEncoded = encode_ric(RIC, State#qpack.dyn_max_size),
