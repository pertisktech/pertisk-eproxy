# syntax=docker/dockerfile:1.7
# Ingress controller image: same release as proxy, defaults to ingress mode + K8s watcher.
# Harbor: harbor.tools.thaidevops.co/pertisksoft/pertisk-eproxy/ingress

FROM erlang:27-alpine AS builder

WORKDIR /src

RUN apk add --no-cache bash git build-base cmake ninja perl patch linux-headers openssl-dev ncurses-dev

COPY . .

RUN chmod +x /src/scripts/patch-ekub.sh /src/scripts/verify-deps.sh /src/scripts/verify-release-build.sh \
    && rm -rf _build \
    && rebar3 get-deps \
    && /src/scripts/patch-ekub.sh \
    && /src/scripts/verify-deps.sh /src \
    && rebar3 as prod release \
    && /src/scripts/verify-release-build.sh /src

FROM alpine:3.20

ARG APP_HOME=/opt/pertisk_eproxy

RUN apk add --no-cache ca-certificates libstdc++ ncurses-libs bash wget sqlite openssl patch \
    && addgroup -g 1000 -S pertisk \
    && adduser -u 1000 -S -G pertisk -h /opt/pertisk_eproxy -s /sbin/nologin pertisk

WORKDIR ${APP_HOME}

COPY --from=builder /usr/lib/libcrypto.so* /usr/lib/
COPY --from=builder /usr/lib/libssl.so* /usr/lib/
COPY --from=builder /lib/libcrypto.so* /lib/
COPY --from=builder /lib/libssl.so* /lib/

COPY --chown=pertisk:pertisk --from=builder /src/config/ingress.json ./config/ingress.json
COPY --chown=pertisk:pertisk --from=builder /src/_build/prod/rel/pertisk_eproxy/ ./

RUN rm -f "${APP_HOME}/log/crash.log" "${APP_HOME}/log/error.log" "${APP_HOME}/log/proxy.log" 2>/dev/null || true \
    && mkdir -p "${APP_HOME}/log" "${APP_HOME}/data" "${APP_HOME}/data/k8s-tls" \
    && chown -R pertisk:pertisk "${APP_HOME}" \
    && chmod 775 "${APP_HOME}/log" "${APP_HOME}/data"

ENV PERTISK_MODE=ingress \
    PERTISK_K8S_INGRESS_ENABLED=true \
    PERTISK_CONFIG_FILE=/opt/pertisk_eproxy/config/ingress.json \
    PERTISK_K8S_TLS_DIR=/opt/pertisk_eproxy/data/k8s-tls

USER pertisk

EXPOSE 8080 8443 9080 8443/udp

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:9080/api/ingress/live || exit 1

ENTRYPOINT ["bin/pertisk_eproxy"]
CMD ["foreground"]
