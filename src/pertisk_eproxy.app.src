{application, pertisk_eproxy, [
    {description, "Erlang reverse proxy (Ranch HTTP/1.1 + pluggable H3 transport, default erlang_quic)"},
    {vsn, "0.1.0"},
    {registered, [
        pertisk_eproxy_sup,
        pertisk_eproxy_config,
        pertisk_eproxy_metrics,
        pertisk_eproxy_backend_sup,
        pertisk_eproxy_admin_realtime,
        pertisk_eproxy_public_ip,
        pertisk_eproxy_acme_dns
    ]},
    {mod, {pertisk_eproxy_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        ssl,
        inets,
        ranch,
        cowboy,
        cowlib,
        quic,
        gun,
        thoas,
        jose,
        lager,
        prometheus
    ]},
    {env, []},
    {modules, []}
]}.
