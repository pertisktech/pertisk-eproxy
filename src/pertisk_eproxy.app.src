{application, pertisk_eproxy, [
    {description, "Erlang Cowboy Reverse Proxy"},
    {vsn, "0.5.79"},
    {registered, [
        pertisk_eproxy_sup,
        pertisk_eproxy_config,
        pertisk_eproxy_metrics,
        pertisk_eproxy_backend_sup,
        pertisk_eproxy_upstream_pool,
        pertisk_eproxy_admin_realtime,
        pertisk_eproxy_public_ip,
        pertisk_eproxy_acme_dns,
        pertisk_ingress_sup,
        pertisk_ingress_watcher,
        pertisk_ingress_leader
    ]},
    {mod, {pertisk_eproxy_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        ssl,
        inets,
        quic,
        cowlib,
        cowboy,
        gun,
        thoas,
        jose,
        lager,
        couchbeam,
        prometheus,
        prometheus_cowboy,
        cowboy_swagger,
        trails,
        ekub,
        ewsc,
        hackney,
        jsx,
        yamerl
    ]},
    {env, []},
    {modules, []}
]}.
