{erl_opts, [debug_info, {parse_transform, lager_transform}]}.

{deps, [
    %% HTTP server
    {cowboy, {git, "https://github.com/ninenines/cowboy.git", {branch, "master"}}},
    %% Pure Erlang QUIC + HTTP/3 (v1.3.0). QPACK RIC=0 Base fix lives in _checkouts/quic (overrides).
    {quic, {git, "https://github.com/benoitc/erlang_quic.git", {tag, "v1.3.0"}}},
    %% QUIC backend for Cowboy HTTP/3 (experimental)
    {quicer, {git, "https://github.com/emqx/quic.git", {branch, "main"}}},
    %% HTTP client (supports HTTP/1.1, HTTP/2, WebSocket)
    {gun, "2.1.0"},
    %% JSON
    {thoas, "1.2.1"},
    %% ACME JWS (RFC 8555)
    {jose, "1.11.10"},
    %% Logging
    {lager, "3.9.2"},
    %% Metrics
    {prometheus, "4.11.0"},
    {prometheus_cowboy, "0.1.8"}
]}.

%% Force-enable Cowboy QUIC code paths at compile-time (experimental HTTP/3).
{overrides, [
    {override, cowboy, [
        {erl_opts, [
            debug_info,
            {d, 'COWBOY_QUICER', 1},
            {d, 'COWBOY_QUIC', 1}
        ]}
    ]}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [pertisk_eproxy]}
]}.

{relx, [
    {release, {pertisk_eproxy, "0.1.0"}, [pertisk_eproxy, sasl]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {include_src, false}
        ]}
    ]}
]}.
