{erl_opts, [debug_info, {parse_transform, lager_transform}]}.

{deps, [
    %% HTTP server
    {cowboy, {git, "https://github.com/ninenines/cowboy.git", {branch, "master"}}},
    %% Pure Erlang QUIC + HTTP/3 (upstream).
    {quic, {git, "https://github.com/benoitc/erlang_quic.git", {tag, "1.6.3"}}},
    %% HTTP client (supports HTTP/1.1, HTTP/2, WebSocket)
    {gun, "2.1.0"},
    %% JSON
    {thoas, "1.2.1"},
    %% ACME JWS (RFC 8555)
    {jose, "1.11.10"},
    %% Logging
    {lager, "3.9.2"},
    {couchbeam, "2.0.0"},
    %% Metrics
    {prometheus, "4.11.0"},
    {prometheus_cowboy, "0.1.8"},
    %% Native Swagger UI + swagger.json on Cowboy routes (/api-docs)
    {cowboy_swagger, "2.8.0"},
    %% Kubernetes API client (Ingress controller)
    {ekub, {git, "https://github.com/travelping/ekub.git", {tag, "0.2.0"}}},
    %% ekub dependency (must be top-level for relx release)
    {ewsc, {git, "https://github.com/aialferov/ewsc.git", {tag, "0.2.0"}}},
    {jsx, "3.1.0"},
    {yamerl, "0.10.0"}
]}.

{overrides, [
    {override, prometheus, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, jose, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, quic, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, lager, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, ranch, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, cowboy, [
        {erl_opts, [nowarn_export_var_subexpr]}
    ]},
    {override, ekub, [
        {deps, [
            {hackney, "1.20.1"}
        ]}
    ]},
    %% git:// URLs fail in Docker; ewsc is required by ekub
    {override, ewsc, [
        {deps, [
            {cpflib, {git, "https://github.com/aialferov/cpflib.git", {branch, "master"}}},
            {wsock, {git, "https://github.com/aialferov/wsock.git", {branch, "master"}}}
        ]}
    ]}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [pertisk_eproxy]}
]}.

{cover_enabled, true}.
{cover_excl_mods, [
    pertisk_eproxy_access_log,
    pertisk_eproxy_acme_client,
    pertisk_eproxy_acme_csr,
    pertisk_eproxy_acme_dns,
    pertisk_eproxy_acme_lego,
    pertisk_eproxy_admin_handler,
    pertisk_eproxy_admin_kubernetes,
    pertisk_eproxy_admin_management_snapshot,
    pertisk_eproxy_admin_realtime,
    pertisk_eproxy_admin_sse_handler,
    pertisk_eproxy_admin_swagger,
    pertisk_eproxy_admin_ws_handler,
    pertisk_eproxy_alt_svc,
    pertisk_eproxy_app,
    pertisk_eproxy_auth,
    pertisk_eproxy_auth0,
    pertisk_eproxy_backend,
    pertisk_eproxy_backend_sup,
    pertisk_eproxy_config,
    pertisk_eproxy_couchdb_log,
    pertisk_eproxy_cowboy_logger,
    pertisk_eproxy_cowboy_stub_conn,
    pertisk_eproxy_db,
    pertisk_eproxy_dns_cloudflare,
    pertisk_eproxy_dns_desec,
    pertisk_eproxy_dns_digitalocean,
    pertisk_eproxy_dns_duckdns,
    pertisk_eproxy_dns_gandi,
    pertisk_eproxy_dns_hetzner,
    pertisk_eproxy_dns_linode,
    pertisk_eproxy_dns_porkbun,
    pertisk_eproxy_dns_powerdns,
    pertisk_eproxy_dns_vultr,
    pertisk_eproxy_env_auth,
    pertisk_eproxy_h3_api_gateway,
    pertisk_eproxy_h3_local_admin,
    pertisk_eproxy_h3_probe_handler,
    pertisk_eproxy_handler,
    pertisk_eproxy_health_cache,
    pertisk_eproxy_lager_json_formatter,
    pertisk_eproxy_lager_ring_backend,
    pertisk_eproxy_log,
    pertisk_eproxy_metrics,
    pertisk_eproxy_metrics_handler,
    pertisk_eproxy_public_ip,
    pertisk_eproxy_spa_handler,
    pertisk_eproxy_stats,
    pertisk_eproxy_sup,
    pertisk_eproxy_tls_cert_info,
    pertisk_eproxy_tls_chain,
    pertisk_eproxy_tls_import,
    pertisk_eproxy_upstream_pool,
    pertisk_eproxy_ws_handler,
    pertisk_ingress_config_sync,
    pertisk_ingress_ekub,
    pertisk_ingress_env,
    pertisk_ingress_leader,
    pertisk_ingress_reconciler,
    pertisk_ingress_status,
    pertisk_ingress_sup,
    pertisk_ingress_tls,
    pertisk_ingress_watcher
]}.

{relx, [
    {release, {pertisk_eproxy, "0.5.18"}, [pertisk_eproxy, quic, sasl]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {include_src, false}
        ]}
    ]}
]}.
