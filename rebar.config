{erl_opts, [debug_info, {parse_transform, lager_transform}]}.

{deps, [
    %% HTTP server
    {cowboy, "2.12.0"},
    %% HTTP client (supports HTTP/1.1, HTTP/2, WebSocket)
    {gun, "2.1.0"},
    %% JSON
    {thoas, "1.2.1"},
    %% Logging
    {lager, "3.9.2"},
    %% Metrics
    {prometheus, "4.11.0"},
    {prometheus_cowboy, "0.1.8"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [pertisk_eproxy]}
]}.

{relx, [
    {release, {pertisk_eproxy, "0.1.0"}, [pertisk_eproxy, sasl]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {include_src, false}
        ]}
    ]}
]}.
