{erl_opts, [debug_info, {parse_transform, lager_transform}]}.

{deps, [
    {ranch, "2.1.0"},
    {cowboy, "2.10.0"},
    {cowlib, "2.16.0"},
    %% Pure Erlang QUIC + HTTP/3 (v1.3.0).
    {quic, {git, "https://github.com/benoitc/erlang_quic.git", {tag, "v1.3.0"}}},
    {gun, "2.1.0"},
    {thoas, "1.2.1"},
    {jose, "1.11.10"},
    {lager, "3.9.2"},
    {prometheus, "4.11.0"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [pertisk_eproxy]}
]}.

{relx, [
    {release, {pertisk_eproxy, "0.1.0"}, [pertisk_eproxy, sasl]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {include_src, false},
            {overlay, [
                {mkdir, "log"},
                {mkdir, "data"},
                %% Edge reverse-proxy defaults (HTTP/HTTPS + HTTP/3 like nginx; CAP_NET_BIND_SERVICE in unit).
                {copy, "packaging/proxy.package.json", "config/proxy.json"}
            ]}
        ]}
    ]}
]}.
