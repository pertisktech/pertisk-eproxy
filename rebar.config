{erl_opts, [debug_info, {i, "include"}]}.

{deps, [
    {cowboy, "2.10.0"},
    {jiffy, "1.1.1"},
    {quic, {git, "https://github.com/benoitc/erlang_quic.git", {branch, "main"}}},
    {lager, "3.9.2"}
]}.

{relx, [
    {release, {pertisk_eproxy, "0.1.0"}, [
        pertisk_eproxy,
        cowboy,
        jiffy,
        quic,
        lager,
        ssl,
        inets,
        crypto,
        asn1,
        public_key
    ]},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {mode, prod}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]},
    {dev, [
        {relx, [
            {dev_mode, true},
            {include_erts, false}
        ]}
    ]}
]}.

{minimum_otp_vsn, "25"}.
