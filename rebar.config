{erl_opts, [debug_info, {i, "include"}]}.

%% After deps compile, patch erlang_quic H3 handler scheduling (GET inline; POST/PUT/PATCH spawn) and recompile quic once.
{post_hooks, [{compile, "bash \"$REBAR_ROOT_DIR/scripts/post_compile_patch_quic.sh\""}]}.

%% Boot the app (and listeners) for `rebar3 shell` / `make run-web` — otherwise nothing listens on TCP/UDP 443.
{shell, [
    {apps, [pertisk_eproxy]},
    {config, "config/sys.config"}
]}.

{deps, [
    {cowboy, "2.10.0"},
    {jiffy, "1.1.1"},
    {quic, {git, "https://github.com/benoitc/erlang_quic.git", {branch, "main"}}},
    {jsone, "1.8.0"},
    {jsonlog, {git, "https://github.com/tsloughter/jsonlog.git", {branch, "main"}}}
]}.

{relx, [
    {release, {pertisk_eproxy, "0.1.0"}, [
        pertisk_eproxy,
        cowboy,
        jiffy,
        quic,
        jsone,
        jsonlog,
        ssl,
        inets,
        crypto,
        asn1,
        public_key
    ]},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {mode, prod}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]},
    {dev, [
        {relx, [
            {dev_mode, true},
            {include_erts, false}
        ]}
    ]}
]}.

%% erlang_quic (quic app) requires OTP >= 26 — see https://github.com/benoitc/erlang_quic#requirements
{minimum_otp_vsn, "26"}.
