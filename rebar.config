{erl_opts, [
    debug_info,
    {parse_transform, lager_transform},
    %% Bound log message size to limit memory churn under large terms (default 4096).
    {lager_truncation_size, 2048}
]}.

{deps, [
    %% HTTP server
    {cowboy, {git, "https://github.com/ninenines/cowboy.git", {branch, "master"}}},
    %% Pure Erlang QUIC + HTTP/3 (upstream).
    {quic, {git, "https://github.com/benoitc/erlang_quic.git", {tag, "1.6.3"}}},
    %% HTTP client (supports HTTP/1.1, HTTP/2, WebSocket)
    {gun, "2.1.0"},
    %% JSON
    {thoas, "1.2.1"},
    %% ACME JWS (RFC 8555)
    {jose, "1.11.10"},
    %% Logging
    {lager, "3.9.2"},
    {couchbeam, "2.0.0"},
    %% Metrics
    {prometheus, "4.11.0"},
    {prometheus_cowboy, "0.1.8"},
    %% Native Swagger UI + swagger.json on Cowboy routes (/api-docs)
    {cowboy_swagger, "2.8.0"},
    %% Kubernetes API client (Ingress controller)
    {ekub, {git, "https://github.com/travelping/ekub.git", {tag, "0.2.0"}}},
    %% ekub dependency (must be top-level for relx release)
    {ewsc, {git, "https://github.com/aialferov/ewsc.git", {tag, "0.2.0"}}},
    {jsx, "3.1.0"},
    {yamerl, "0.10.0"}
]}.

{overrides, [
    {override, prometheus, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, jose, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, quic, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, lager, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, couchbeam, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, hackney, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, goldrush, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, yamerl, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, ranch, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    {override, cowboy, [
        {erl_opts, [nowarn_export_var_subexpr]}
    ]},
    {override, ekub, [
        {deps, [
            {hackney, "1.20.1"}
        ]}
    ]},
    {override, meck, [
        {erl_opts, [nowarn_deprecated_catch]}
    ]},
    %% git:// URLs fail in Docker; ewsc is required by ekub
    {override, ewsc, [
        {deps, [
            {cpflib, {git, "https://github.com/aialferov/cpflib.git", {branch, "master"}}},
            {wsock, {git, "https://github.com/aialferov/wsock.git", {branch, "master"}}}
        ]}
    ]}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [pertisk_eproxy]}
]}.

{cover_enabled, true}.
{cover_excl_mods, []}.

{project_plugins, [rebar3_ex_doc]}.

{ex_doc, [
    {source_url, <<"https://github.com/pertisktech/pertisk-eproxy">>},
    {homepage_url, <<"https://pertisktech.github.io/pertisk-eproxy/">>},
    {extras, [
        {"docs/README.md", #{title => <<"Documentation">>}},
        {"docs/overview.md", #{title => <<"Overview">>}},
        {"docs/quickstart.md", #{title => <<"Quickstart">>}},
        {"docs/tutorials/your-first-proxy.md", #{title => <<"Your first reverse proxy">>}},
        {"docs/tutorials/ingress-controller.md", #{title => <<"Run the ingress controller">>}},
        {"docs/guides/configure-sites-backends.md", #{title => <<"Configure sites and backends">>}},
        {"docs/guides/hot-reload.md", #{title => <<"Hot-reload configuration">>}},
        {"docs/guides/logging.md", #{title => <<"Log level and access logging">>}},
        {"docs/guides/import-tls-certificates.md", #{title => <<"Import TLS certificates">>}},
        {"docs/guides/tune-ingress-throughput.md", #{title => <<"Tune ingress throughput">>}},
        {"docs/guides/prometheus-metrics.md", #{title => <<"Prometheus metrics">>}},
        {"docs/guides/deploy-with-helm.md", #{title => <<"Deploy with Helm">>}},
        {"docs/concepts/architecture.md", #{title => <<"Architecture">>}},
        {"docs/concepts/proxy-vs-ingress.md", #{title => <<"Proxy vs ingress mode">>}},
        {"docs/concepts/request-lifecycle.md", #{title => <<"Request lifecycle">>}},
        {"docs/concepts/kubernetes-ingress.md", #{title => <<"Kubernetes ingress">>}},
        {"docs/README_SQLITE.md", #{title => <<"SQLite and ACME">>}},
        {"docs/QUIC.md", #{title => <<"HTTP/3 (QUIC)">>}},
        {"docs/K8S_INGRESS_IMPLEMENTATION.md", #{title => <<"Ingress implementation">>}},
        {"docs/RPM_UPGRADE.md", #{title => <<"RPM upgrade">>}}
    ]},
    {main, <<"readme">>},
    {groups_for_extras, [
        {<<"Start here">>, [
            <<"docs/README.md">>,
            <<"docs/overview.md">>,
            <<"docs/quickstart.md">>
        ]},
        {<<"Tutorials">>, [
            <<"docs/tutorials/your-first-proxy.md">>,
            <<"docs/tutorials/ingress-controller.md">>
        ]},
        {<<"How-to guides">>, [
            <<"docs/guides/configure-sites-backends.md">>,
            <<"docs/guides/hot-reload.md">>,
            <<"docs/guides/logging.md">>,
            <<"docs/guides/import-tls-certificates.md">>,
            <<"docs/guides/tune-ingress-throughput.md">>,
            <<"docs/guides/prometheus-metrics.md">>,
            <<"docs/guides/deploy-with-helm.md">>,
            <<"docs/README_SQLITE.md">>,
            <<"docs/QUIC.md">>,
            <<"docs/RPM_UPGRADE.md">>
        ]},
        {<<"Concepts">>, [
            <<"docs/concepts/architecture.md">>,
            <<"docs/concepts/proxy-vs-ingress.md">>,
            <<"docs/concepts/request-lifecycle.md">>,
            <<"docs/concepts/kubernetes-ingress.md">>,
            <<"docs/K8S_INGRESS_IMPLEMENTATION.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"Application">>, [pertisk_eproxy_app, pertisk_eproxy_sup]},
        {<<"Proxy core">>, [
            pertisk_eproxy_handler,
            pertisk_eproxy_router,
            pertisk_eproxy_backend,
            pertisk_eproxy_backend_sup,
            pertisk_eproxy_lb,
            pertisk_eproxy_upstream_pool,
            pertisk_eproxy_compression,
            pertisk_eproxy_response_headers,
            pertisk_eproxy_ws_handler
        ]},
        {<<"HTTP/3">>, [
            pertisk_eproxy_h3_api_gateway,
            pertisk_eproxy_h3_local_admin,
            pertisk_eproxy_h3_probe_handler,
            pertisk_eproxy_alt_svc
        ]},
        {<<"Admin API">>, [
            pertisk_eproxy_admin_handler,
            pertisk_eproxy_admin_routes,
            pertisk_eproxy_admin_ws_handler,
            pertisk_eproxy_admin_sse_handler,
            pertisk_eproxy_admin_realtime,
            pertisk_eproxy_admin_management_snapshot,
            pertisk_eproxy_admin_kubernetes,
            pertisk_eproxy_admin_swagger,
            pertisk_eproxy_spa_handler
        ]},
        {<<"Ingress controller">>, [
            pertisk_ingress_sup,
            pertisk_ingress_watcher,
            pertisk_ingress_reconciler,
            pertisk_ingress_config_sync,
            pertisk_ingress_leader,
            pertisk_ingress_status,
            pertisk_ingress_status_patcher,
            pertisk_gateway_class_status,
            pertisk_gateway_status,
            pertisk_ingress_metrics,
            pertisk_gateway_reconciler,
            pertisk_eproxy_external_auth,
            pertisk_eproxy_tracing,
            pertisk_eproxy_rate_limit,
            pertisk_ingress_tls,
            pertisk_ingress_ekub,
            pertisk_ingress_env,
            pertisk_k8s_time
        ]},
        {<<"Configuration">>, [pertisk_eproxy_config, pertisk_eproxy_db, pertisk_eproxy_shell]},
        {<<"Authentication">>, [
            pertisk_eproxy_auth,
            pertisk_eproxy_auth0,
            pertisk_eproxy_env_auth
        ]},
        {<<"ACME">>, [
            pertisk_eproxy_acme_client,
            pertisk_eproxy_acme_csr,
            pertisk_eproxy_acme_dns,
            pertisk_eproxy_acme_jwk,
            pertisk_eproxy_acme_lego
        ]},
        {<<"TLS">>, [
            pertisk_eproxy_tls_chain,
            pertisk_eproxy_tls_cert_info,
            pertisk_eproxy_tls_import,
            pertisk_eproxy_tls_paths
        ]},
        {<<"DNS providers">>, [
            pertisk_eproxy_dns_cloudflare,
            pertisk_eproxy_dns_digitalocean,
            pertisk_eproxy_dns_duckdns,
            pertisk_eproxy_dns_desec,
            pertisk_eproxy_dns_gandi,
            pertisk_eproxy_dns_hetzner,
            pertisk_eproxy_dns_linode,
            pertisk_eproxy_dns_porkbun,
            pertisk_eproxy_dns_powerdns,
            pertisk_eproxy_dns_vultr
        ]},
        {<<"Metrics and logging">>, [
            pertisk_eproxy_metrics,
            pertisk_eproxy_metrics_handler,
            pertisk_eproxy_metrics_routes,
            pertisk_eproxy_stats,
            pertisk_eproxy_access_log,
            pertisk_eproxy_log,
            pertisk_eproxy_log_level,
            pertisk_eproxy_lager_json_formatter,
            pertisk_eproxy_lager_ring_backend,
            pertisk_eproxy_couchdb_log,
            pertisk_eproxy_cowboy_logger
        ]},
        {<<"Health and utilities">>, [
            pertisk_eproxy_health_cache,
            pertisk_eproxy_public_ip,
            pertisk_eproxy_cowboy_stub_conn
        ]}
    ]}
]}.

{relx, [
    {release, {pertisk_eproxy, "0.5.45"}, [pertisk_eproxy, quic, sasl]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}
]}.

%% Full-suite runs can exceed the default 5s eunit timeout during mock teardown.
{eunit_opts, [{scale_timeouts, 6.0}]}.

{profiles, [
    {test, [
        {deps, [
            {meck, "0.9.2"}
        ]},
        %% Cover + parallel jobs: allow slow mock teardown and large modules.
        {eunit_opts, [{scale_timeouts, 12.0}, {timeout, 300}]}
    ]},
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {include_src, false}
        ]}
    ]}
]}.
