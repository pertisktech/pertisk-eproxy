       "/Users/dotnetnat/projects/pertisk-tech/pertisk-eproxy-old/_checkouts/quic/src/quic.app.src",
       undefined,undefined,"1.3.0","1.3.0",root,
       [{description,"Pure Erlang QUIC implementation (RFC 9000)"},
        {vsn,"1.3.0"},
        {registered,
         [quic_sup,quic_server_registry,quic_server_sup,quic_dist_sup,
          quic_dist_tickets,quic_dist_nat]},
        {mod,{quic_app,[]}},
        {applications,[kernel,stdlib,crypto,ssl]},
        {env,[]},
        {modules,[]},
        {licenses,["Apache-2.0"]},
        {links,[{"GitHub","https://github.com/benoitc/erlang_quic"}]}],
       [kernel,stdlib,crypto,ssl],
       [],[],[],
       [default],
       {dict,17,16,16,8,80,48,
        {[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[]},
        {{[],
          [[{deps,default}],[{plugins,default}]],
          [[dialyzer,
            {warnings,[error_handling,unknown]},
            {plt_apps,all_deps},
            {plt_extra_apps,[crypto,ssl]}]],
          [[erl_opts,debug_info,warn_export_vars,warn_shadow_vars,
            warn_obsolete_guard,
            {platform_define,"^[0-9]+",namespaced_types}],
           [src_dirs,"src","src/dist","src/interop","src/qpack","src/h3"],
           [deps],
           [profiles,
            {test,
             [{deps,[{proper,"1.4.0"}]},
              {erl_opts,[debug_info,nowarn_export_all]}]},
            {interop_client,
             [{escript_main_app,quic},
              {escript_name,quic_interop_client},
              {escript_emu_args,"%%! -escript main quic_interop_client\n"}]},
            {interop_server,
             [{escript_main_app,quic},
              {escript_name,quic_interop_server},
              {escript_emu_args,"%%! -escript main quic_interop_server\n"}]},
            {h3_client,
             [{escript_main_app,quic},
              {escript_name,quic_h3_client},
              {escript_emu_args,"%%! -escript main quic_h3_client\n"}]},
            {h3_server,
             [{escript_main_app,quic},
              {escript_name,quic_h3_server},
              {escript_emu_args,"%%! -escript main quic_h3_server\n"}]},
            {dist_node,
             [{relx,
               [{release,{quic_node,"0.1.0"},[quic,sasl]},
                {mode,prod},
                {include_erts,true},
                {extended_start_script,true},
                {sys_config_src,"config/dist_sys.config.src"},
                {vm_args_src,"config/dist_vm.args.src"}]}]}],
           [project_plugins,
            {rebar3_proper,"~> 0.12"},
            {rebar3_hex,"~> 7.0"},
            {rebar3_ex_doc,"~> 0.2"},
            {rebar3_lint,"~> 5.0"},
            {erlfmt,"~> 1.7"}],
           [ex_doc,
            {source_url,<<"https://github.com/benoitc/erlang_quic">>},
            {extras,
             [<<"README.md">>,<<"CHANGELOG.md">>,
              <<"docs/GETTING_STARTED.md">>,<<"docs/DEVELOPER_GUIDE.md">>,
              <<"docs/features.md">>,<<"docs/DESIGN.md">>,
              <<"docs/SERVER_GUIDE.md">>,<<"docs/CLIENT_GUIDE.md">>,
              <<"docs/QUIC_DIST.md">>,<<"docs/QLOG_GUIDE.md">>,
              <<"docs/HTTP3.md">>,<<"docs/PERFORMANCE.md">>]},
            {groups_for_extras,
             [{<<"Guides">>,
               [<<"docs/GETTING_STARTED.md">>,<<"docs/DEVELOPER_GUIDE.md">>,
                <<"docs/CLIENT_GUIDE.md">>,<<"docs/SERVER_GUIDE.md">>]},
              {<<"Reference">>,
               [<<"docs/features.md">>,<<"docs/DESIGN.md">>,
                <<"docs/PERFORMANCE.md">>]},
              {<<"Advanced">>,
               [<<"docs/QUIC_DIST.md">>,<<"docs/QLOG_GUIDE.md">>,
                <<"docs/HTTP3.md">>]}]},
            {main,<<"readme">>},
            {groups_for_modules,
             [{<<"Public API">>,[quic,quic_listener]},
              {<<"Connection">>,[quic_connection,quic_stream]},
              {<<"Protocol">>,[quic_packet,quic_frame,quic_varint]},
              {<<"Cryptography">>,
               [quic_crypto,quic_tls,quic_keys,quic_aead,quic_hkdf]},
              {<<"Flow Control">>,[quic_flow,quic_cc,quic_loss,quic_ack]},
