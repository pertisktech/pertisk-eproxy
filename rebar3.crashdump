              {<<"Load Balancer">>,[quic_lb]}]}],
           [elvis,
            {config,
             [#{files =>
                 ["src/*.erl","src/dist/**/*.erl","src/interop/**/*.erl",
                  "src/qpack/**/*.erl","src/h3/**/*.erl"],
                rules =>
                 [{elvis_style,no_macros,disable},
                  {elvis_style,state_record_and_type,
                   #{ignore =>
                      [quic_dist_controller,quic_dist_tickets,quic_listener,
                       quic_listener_manager,quic_server_registry,
                       quic_connection,quic_h3_connection]}},
                  {elvis_style,private_data_types,
                   #{ignore =>
                      [quic_keys,quic_loss,quic_packet,quic_ticket,quic_lb,
                       quic,quic_cc]}},
                  {elvis_style,no_receive_without_timeout,
                   #{ignore =>
                      [quic_dist,quic_dist_controller,quic_interop_server,
                       quic_h3_server]}},
                  {elvis_style,no_debug_call,
                   #{ignore =>
                      [quic_interop_client,quic_interop_server,quic_h3_client,
                       quic_h3_server]}},
                  {elvis_style,atom_naming_convention,
                   #{ignore => [quic_dist],
                     regex => "^[a-z](_?[a-zA-Z0-9]+)*(_SUITE)?$"}},
                  {elvis_style,prefer_strict_generators,disable},
                  {elvis_style,prefer_sigils,disable},
                  {elvis_style,consistent_ok_error_spec,disable},
                  {elvis_style,abc_size,disable},
                  {elvis_style,code_complexity,disable},
                  {elvis_style,consistent_variable_naming,disable},
                  {elvis_style,no_common_caveats_call,disable},
                  {elvis_style,no_init_lists,disable},
                  {elvis_style,no_spec_with_records,disable},
                  {elvis_style,param_pattern_matching,disable},
                  {elvis_style,no_used_ignored_variables,disable},
                  {elvis_style,no_throw,
                   #{ignore =>
                      [quic_qpack,quic_qpack_huffman,quic_h3_frame,
                       quic_h3_connection]}},
                  {elvis_text_style,max_line_length,#{limit => 120}},
                  {elvis_style,no_if_expression,
                   #{ignore =>
                      [quic_aead,quic_discovery_dns,quic_stream,
                       quic_connection]}},
                  {elvis_style,no_deep_nesting,
                   #{ignore =>
                      [quic_listener,quic_interop_client,quic_connection,
                       quic_h3_client]}},
                  {elvis_style,variable_naming_convention,
                   #{ignore => [quic_tls]}},
                  {elvis_style,dont_repeat_yourself,
                   #{ignore =>
                      [quic_ack,quic_connection,quic_cc,quic_cc_bbr,
                       quic_cc_cubic,quic_cc_newreno,quic_discovery_dns,
                       quic_listener,quic_loss,quic_aead,quic_dist_controller,
                       quic_packet,quic_interop_client,quic_socket,quic_tls,
                       quic_qpack,quic_qpack_huffman,quic_h3_frame,
                       quic_h3_connection]}},
                  {elvis_style,max_function_length,
                   #{ignore =>
                      [quic_ack,quic_cc,quic_cc_bbr,quic_cc_cubic,
                       quic_cc_newreno,quic_connection,quic_dist,
                       quic_dist_controller,quic_frame,quic_interop_client,
                       quic_lb,quic_listener,quic_loss,quic_packet,quic_pmtu,
                       quic_qlog,quic_socket,quic_stream,quic_sup,quic_tls,
                       quic_qpack,quic_qpack_huffman,quic_h3_frame,
                       quic_h3_connection,quic_h3_client,quic_h3_server]}},
                  {elvis_style,no_god_modules,
                   #{ignore =>
                      [quic,quic_cc,quic_cc_bbr,quic_cc_cubic,quic_cc_newreno,
                       quic_connection,quic_crypto,quic_stream,
                       quic_dist_controller,quic_qpack,quic_h3,
                       quic_h3_connection],
                     limit => 30}},
                  {elvis_style,max_function_clause_length,
                   #{ignore =>
                      [quic_ack,quic_cc,quic_cc_bbr,quic_cc_cubic,
                       quic_cc_newreno,quic_connection,quic_dist,
                       quic_dist_controller,quic_interop_client,quic_lb,
                       quic_listener,quic_packet,quic_pmtu,quic_socket,
                       quic_stream,quic_sup,quic_tls,quic_loss,quic_qpack,
                       quic_h3_connection,quic_h3_client,quic_h3_server]}},
                  {elvis_style,max_module_length,
                   #{ignore =>
                      [quic_cc_bbr,quic_cc_cubic,quic_cc_newreno,
                       quic_connection,quic_dist,quic_dist_controller,
                       quic_interop_client,quic_listener,quic_loss,
                       quic_socket,quic_tls,quic_qpack,quic_h3_connection]}},
                  {elvis_style,max_function_arity,#{ignore => [quic_loss]}},
                  {elvis_style,max_record_fields,
                   #{ignore =>
                      [quic_cc_bbr,quic_cc_cubic,quic_cc_newreno,
                       quic_connection,quic_dist_controller,
                       quic_h3_connection]}},
                  {elvis_style,no_catch_expressions,
                   #{ignore => [quic_dist,quic_h3_connection]}},
                  {elvis_style,simplify_anonymous_functions,
                   #{ignore => [quic_dist]}},
                  {elvis_style,no_invalid_dynamic_calls,
                   #{ignore => [quic_dist,quic_h3_connection]}}],
                ruleset => erl_files},
              #{files => ["include/*.hrl"],ruleset => hrl_files},
              #{files => ["rebar.config"],ruleset => rebar_config}]}],
